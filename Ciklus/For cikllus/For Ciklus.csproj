int szam = 997;
bool isPrime = true;

for (int i = 2; i < szam + 1; i++)
{
    if (szam % i == 0)
    {
        isPrime = false;
        Console.WriteLine($"Ezzel a számmal osztahtó: {i}");
        break;
    }
    Console.WriteLine(i);
}

if (isPrime)
{
    Console.WriteLine("Prím");
}
else
{
    Console.WriteLine("nem pírm");
}